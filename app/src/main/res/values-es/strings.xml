    <string name="lm_addis">Adís Abeba</string>
    <string name="lm_addis_desc">La capital diplomática de África, hogar de la Unión Africana, el Museo Nacional con el fósil \'Lucy\', Merkato y la animada cultura del café.</string>
    <string name="lm_axum">Obeliscos de Aksum</string>
    <string name="lm_axum_desc">Estellas talladas de la antigua dinastía Aksumita, Patrimonio de la Humanidad de la UNESCO y el famoso lugar de descanso del Arca del Pacto.</string>
    <string name="lm_bale">Montañas Bale</string>
    <string name="lm_bale_desc">Planas altas afro-alpinas y el bosque de Harenna, hogar del lobo etíope y la nyala de montaña.</string>
    <string name="lm_blue_nile">Las cataratas del Nilo Azul</string>
    <string name="lm_blue_nile_desc">Tis Abay, \'el agua que fuma\', donde el Nilo Azul se hunde en una garganta cerca de Bahir Dar.</string>
    <string name="lm_danakil">La depresión de Danakil</string>
    <string name="lm_danakil_desc">Uno de los lugares más calientes de la Tierra, con coloridos manantiales de azufre en Dallol y caravanas de sal.</string>
    <string name="lm_erta_ale">Erta Ale</string>
    <string name="lm_erta_ale_desc">Un volcán escudo en Afar conocido por su lago de lava.</string>
    <string name="lm_gondar">Fasil Ghebbi, Gondar</string>
    <string name="lm_gondar_desc">Los castillos reales del siglo XVII de Gondar, Patrimonio de la Humanidad por la UNESCO.</string>
    <string name="lm_harar">Harar Jugol</string>
    <string name="lm_harar_desc">La ciudad antigua amurallada de Harar con 82 mezquitas, callejones coloridos y los hyenas de alimentación. Patrimonio de la Humanidad por la UNESCO.</string>
    <string name="lm_konso">Paisaje cultural de Konso</string>
    <string name="lm_konso_desc">Terrasas de paredes de piedra y pueblos fortificados con forma de más de 400 años. Patrimonio de la Humanidad por la UNESCO.</string>
    <string name="lm_lake_tana">Los monasterios del lago Tana</string>
    <string name="lm_lake_tana_desc">El lago más grande de Etiopía, fuente del Nilo Azul, con monasterios isleños medievales.</string>
    <string name="lm_lalibela">Iglesias de roca, Lalibela</string>
    <string name="lm_lalibela_desc">Once iglesias monolíticas medievales talladas en roca, un sitio de peregrinación vivo y Patrimonio Mundial de la UNESCO.</string>
    <string name="lm_simien">Montañas similares</string>
    <string name="lm_simien_desc">Escarpas dramáticas, monos gelados y Ras Dashen, la cima más alta de Etiopía. Patrimonio de la Humanidad por la UNESCO.</string>
    <string name="lm_tiya">Tiya Stelae</string>
    <string name="lm_tiya_desc">Un sitio arqueológico de piedras de pie talladas al sur de Addis Abeba. Patrimonio de la Humanidad por la UNESCO.</string>
