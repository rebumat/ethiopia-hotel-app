    <string name="lm_addis">Addis Ababa</string>
    <string name="lm_addis_desc">Africa\'s diplomatic capital, home of the African Union, the National Museum with the fossil \'Lucy\', Merkato and lively coffee culture.</string>
    <string name="lm_axum">Aksum Obelisks</string>
    <string name="lm_axum_desc">Towering carved stelae of the ancient Aksumite kingdom, a UNESCO World Heritage Site and the reputed resting place of the Ark of the Covenant.</string>
    <string name="lm_bale">Bale Mountains</string>
    <string name="lm_bale_desc">Afro-alpine plateaus and the Harenna forest, home of the Ethiopian wolf and mountain nyala.</string>
    <string name="lm_blue_nile">Blue Nile Falls</string>
    <string name="lm_blue_nile_desc">Tis Abay, \'the smoking water\', where the Blue Nile plunges into a gorge near Bahir Dar.</string>
    <string name="lm_danakil">Danakil Depression</string>
    <string name="lm_danakil_desc">One of the hottest places on Earth, with colourful sulphur springs at Dallol and salt caravans.</string>
    <string name="lm_erta_ale">Erta Ale</string>
    <string name="lm_erta_ale_desc">A shield volcano in Afar known for its lava lake.</string>
    <string name="lm_gondar">Fasil Ghebbi, Gondar</string>
    <string name="lm_gondar_desc">The 17th-century royal castles of Gondar, a UNESCO World Heritage Site.</string>
    <string name="lm_harar">Harar Jugol</string>
    <string name="lm_harar_desc">The walled old city of Harar with 82 mosques, colourful alleys and the hyena feeders. UNESCO World Heritage.</string>
    <string name="lm_konso">Konso Cultural Landscape</string>
    <string name="lm_konso_desc">Stone-walled terraces and fortified villages shaped over 400 years. UNESCO World Heritage.</string>
    <string name="lm_lake_tana">Lake Tana Monasteries</string>
    <string name="lm_lake_tana_desc">Ethiopia\'s largest lake, source of the Blue Nile, with medieval island monasteries.</string>
    <string name="lm_lalibela">Rock-Hewn Churches, Lalibela</string>
    <string name="lm_lalibela_desc">Eleven medieval monolithic churches carved from rock, a living pilgrimage site and UNESCO World Heritage.</string>
    <string name="lm_simien">Simien Mountains</string>
    <string name="lm_simien_desc">Dramatic escarpments, gelada monkeys and Ras Dashen, Ethiopia\'s highest peak. UNESCO World Heritage.</string>
    <string name="lm_tiya">Tiya Stelae</string>
    <string name="lm_tiya_desc">An archaeological site of carved standing stones south of Addis Ababa. UNESCO World Heritage.</string>
