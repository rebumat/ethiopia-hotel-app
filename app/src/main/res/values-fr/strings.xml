    <string name="lm_addis">Addis-Abeba</string>
    <string name="lm_addis_desc">Capitale diplomatique de l\'Afrique, foyer de l\'Union africaine, musée national avec le fossile \"Lucy\", Merkato et culture du café animée.</string>
    <string name="lm_axum">Obélisques d\'Aksum</string>
    <string name="lm_axum_desc">Des stèles sculptées du royaume d\'Aksum, classées au patrimoine mondial de l\'UNESCO et le lieu de repos réputé de l\'Arche de l\'Alliance.</string>
    <string name="lm_bale">Les montagnes de Bale</string>
    <string name="lm_bale_desc">Les plateaux afro-alpins et la forêt Harenna, foyer du loup éthiopien et de la nyala de montagne.</string>
    <string name="lm_blue_nile">Les chutes du Nil bleu</string>
    <string name="lm_blue_nile_desc">Tis Abay, \"l\'eau fumante\", où le Nil bleu plonge dans une gorge près de Bahir Dar.</string>
    <string name="lm_danakil">La dépression de Danakil</string>
    <string name="lm_danakil_desc">L\'un des endroits les plus chauds de la Terre, avec des sources de soufre colorées à Dallol et des caravanes salées.</string>
    <string name="lm_erta_ale">Le lait de vache</string>
    <string name="lm_erta_ale_desc">Un volcan de bouclier en Afar connu pour son lac de lave.</string>
    <string name="lm_gondar">Fasil Ghebbi, Gondar</string>
    <string name="lm_gondar_desc">Les châteaux royaux du 17ème siècle de Gondar, inscrits au patrimoine mondial de l\'UNESCO.</string>
    <string name="lm_harar">Harar Jugol</string>
    <string name="lm_harar_desc">La vieille ville fortifiée de Harar avec 82 mosquées, ruelles colorées et les fourmis d\'hyènes. Patrimoine mondial de l\'UNESCO.</string>
    <string name="lm_konso">Paysage culturel de Konso</string>
    <string name="lm_konso_desc">Des terrasses en pierre et des villages fortifiés ont été construits depuis plus de 400 ans. Patrimoine mondial de l\'UNESCO.</string>
    <string name="lm_lake_tana">Monastères du lac Tana</string>
    <string name="lm_lake_tana_desc">Le plus grand lac d\'Éthiopie, source du Nil bleu, avec des monastères insulaires médiévaux.</string>
    <string name="lm_lalibela">Des églises taillées dans le rocher, à Lalibela</string>
    <string name="lm_lalibela_desc">Onze églises monolithiques médiévales sculptées dans le roc, un site de pèlerinage vivant et patrimoine mondial de l\'UNESCO.</string>
    <string name="lm_simien">Montagnes semblables</string>
    <string name="lm_simien_desc">Des escarpements spectaculaires, des singes glacés et Ras Dashen, le plus haut sommet d\'Éthiopie. Patrimoine mondial de l\'UNESCO.</string>
    <string name="lm_tiya">Tiya Stelae</string>
    <string name="lm_tiya_desc">Un site archéologique de pierres taillées au sud d\'Addis-Abeba. Patrimoine mondial de l\'UNESCO.</string>
